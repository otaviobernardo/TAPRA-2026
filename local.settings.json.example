{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "HTTP_FUNCTION_URL": "http://localhost:7071/api/HttpTriggerEcho",
    "HOST": "<servidor>.database.windows.net",
    "DATABASE": "<banco>",
    "USER": "<usuario>",
    "PASSWORD": "<senha>",
    "DATALAKE_CONNECTION_STRING": "DefaultEndpointsProtocol=https;AccountName=<conta>;AccountKey=<chave>;EndpointSuffix=core.windows.net",
    "BRONZE_CONTAINER": "bronze"
  }
}
